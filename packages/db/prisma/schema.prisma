// FlipPlan — schema dati
//
// Principio guida: i campi persistiti sono INPUT dell'utente (o riferimenti).
// I valori derivati (IVA calcolata, totali, margini, ROI, piano di ammortamento
// interest-only/francese, ecc.) NON sono colonne in DB: vengono calcolati sempre
// dal motore di calcolo condiviso (packages/shared) a partire dagli input, per
// evitare che un numero mostrato in UI possa "andare fuori sync" da come è stato
// calcolato. Fa eccezione LoanPayment, che è persistito SOLO quando il piano di
// rate è "MANUAL" (l'utente riporta un piano di ammortamento reale fornito dalla banca).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant / utenti / auth
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  deals               Deal[]
  vendors             Vendor[]
  clients             Client[]
  costCategories      CostCategory[]
  priceListItems      PriceListItem[]
  costTemplates       CostTemplate[]
  companyLoans        CompanyLoan[]
  companyProfile      CompanyProfile?
  businessPlanTemplates BusinessPlanTemplate[]
  businessPlans       BusinessPlan[]
  attachments         Attachment[]

  @@map("tenants")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  createdDeals  Deal[]        @relation("DealCreatedBy")
  notes         Note[]
  attachments   Attachment[]

  @@index([tenantId])
  @@map("users")
}

// Sessioni custom (cookie httpOnly, token hashato in DB). Struttura pensata
// per poter aggiungere in futuro una tabella "Account" in stile Auth.js per
// il login OAuth, senza dover toccare User/Session.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Deal
// ---------------------------------------------------------------------------

enum DealStatus {
  VALUTAZIONE
  ACQUISIZIONE
  RISTRUTTURAZIONE
  VENDITA
  CHIUSO
  ARCHIVIATO
}

// FLIP: operazione di acquisto + ristrutturazione + rivendita, i costi di
// Materiali/Lavorazioni sono i costi reali che sostieni.
// RISTRUTTURAZIONE_CLIENTE: lavori eseguiti per un cliente terzo (non un
// immobile tuo): Materiali/Lavorazioni hanno anche un "prezzo cliente"
// (CostLineItem.clientPrice), diverso dal costo, usato per generare il
// preventivo da consegnare al cliente.
enum DealOperationType {
  FLIP
  RISTRUTTURAZIONE_CLIENTE
}

model Deal {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User              @relation("DealCreatedBy", fields: [createdById], references: [id])
  name          String
  address       String?
  propertyType  String?
  surfaceSqm    Decimal?          @db.Decimal(8, 2)
  operationType DealOperationType @default(FLIP)
  clientName      String? // solo per RISTRUTTURAZIONE_CLIENTE: il committente a cui va il preventivo
  clientAddress   String?
  clientTaxCode   String? // codice fiscale
  clientVatNumber String? // partita IVA
  clientPhone     String?
  clientEmail     String?
  quoteDate       DateTime? // data di creazione del preventivo
  quoteValidUntil DateTime? // data di validità del preventivo
  quoteStatus     QuoteStatus @default(BOZZA) // avanzamento del preventivo cliente: bozza -> inviato -> accettato/rifiutato
  clientAmountReceived Decimal? @db.Decimal(14, 2) // deprecato, non più scritto: vedi clientAcconto1Amount ecc.
  // Incassi dal cliente a rate (RISTRUTTURAZIONE_CLIENTE): fino a 3 acconti
  // (ciascuno con % sul totale preventivo + importo) più un saldo finale.
  clientAcconto1Pct    Decimal? @db.Decimal(5, 2)
  clientAcconto1Amount Decimal  @db.Decimal(14, 2) @default(0)
  clientAcconto1DueDate DateTime? // scadenza prevista (opzionale): se passata e l'importo è ancora 0, segnalato come in ritardo
  clientAcconto2Pct    Decimal? @db.Decimal(5, 2)
  clientAcconto2Amount Decimal  @db.Decimal(14, 2) @default(0)
  clientAcconto2DueDate DateTime?
  clientAcconto3Pct    Decimal? @db.Decimal(5, 2)
  clientAcconto3Amount Decimal  @db.Decimal(14, 2) @default(0)
  clientAcconto3DueDate DateTime?
  clientSaldoAmount    Decimal  @db.Decimal(14, 2) @default(0)
  clientSaldoDueDate   DateTime?
  status        DealStatus        @default(VALUTAZIONE)
  isDemo        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  acquisitionDetails AcquisitionDetails?
  fiscalSettings     FiscalSettings?
  renovationSettings RenovationSettings?
  holdingCosts       HoldingCostsConfig?
  costLineItems      CostLineItem[]
  loans              Loan[]
  partners           Partner[]
  saleScenarios      SaleScenario[]
  notes              Note[]
  attachments        Attachment[]
  businessPlanDeals  BusinessPlanDeal[]
  vendorPayments     DealVendorPayment[]
  quoteSnapshots     QuoteSnapshot[]

  @@index([tenantId, status])
  @@map("deals")
}

enum QuoteStatus {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

// Storico versioni del preventivo cliente: uno snapshot viene salvato ogni
// volta che il preventivo viene stampato/scaricato, per poter confrontare
// cosa è stato proposto al cliente nel tempo (es. dopo una trattativa sul
// prezzo). Le voci sono congelate in JSON: non seguono modifiche successive
// alle voci di costo reali del deal.
model QuoteSnapshot {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  grandTotal Decimal  @db.Decimal(14, 2)
  vatRatePct Decimal  @db.Decimal(5, 2)
  items      Json // [{ description, quantity, unit, price }]

  @@index([dealId])
  @@map("quote_snapshots")
}

// Prezzo di acquisto isolato dagli altri costi di acquisizione (notaio,
// agenzia, due diligence, ecc. sono CostLineItem con categoria group=ACQUISIZIONE):
// serve come base imponibile per la plusvalenza e per il breakeven.
model AcquisitionDetails {
  dealId        String    @id
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  purchasePrice Decimal   @db.Decimal(14, 2)
  depositAmount Decimal?  @db.Decimal(14, 2) // acconto/caparra già versata, a titolo informativo (non modifica il costo totale di acquisizione)
  // Data reale (o prevista) di acquisto: punto di partenza per calcolare
  // quali rate dei finanziamenti aziendali (CompanyLoan) ricadono nella
  // finestra di detenzione di questo flip.
  purchaseDate  DateTime?
  // Base per calcolare in automatico l'imposta di registro: "prima casa"
  // (2% sulla rendita catastale) o "seconda casa" (9% sul prezzo di
  // acquisto). Null finché non impostata (scheda Acquisizione).
  purchaseCategory PurchaseCategoryType?
  // Rendita catastale dell'immobile, dalla visura catastale (RTI): base per
  // l'imposta di registro "prima casa" (2%) e per il calcolo IMU.
  renditaCatastale Decimal? @db.Decimal(14, 2)
  // Quota di partecipazione dell'azienda in questo flip, se fatto insieme ad
  // altre società (es. 50% in due, 33,3% in tre). 100 = flip fatto da soli
  // (default). Usata solo per mostrare "a mio carico" su costi/utile in
  // scheda Risultati — non entra nei calcoli di costo/margine/imposte, che
  // restano sul 100% del progetto.
  ownStakePct   Decimal   @default(100) @db.Decimal(5, 2)
  notes         String?
  updatedAt     DateTime  @updatedAt

  @@map("acquisition_details")
}

enum PurchaseCategoryType {
  PRIMA_CASA
  SECONDA_CASA
}

enum FiscalRegimeType {
  SOCIETA_CAPITALI
  PERSONA_FISICA
  ALTRO
}

// Configurazione fiscale del deal: IVA su vendita/costi, e regime imposte
// sull'operazione (IRES+IRAP per società di capitali, plusvalenza sostitutiva
// per persona fisica, parametrico per altri regimi).
model FiscalSettings {
  dealId                  String           @id
  deal                    Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  regimeType              FiscalRegimeType @default(PERSONA_FISICA)
  saleSubjectToVat        Boolean          @default(false)
  costsVatRecoverable     Boolean          @default(false)
  iresRatePct             Decimal          @db.Decimal(5, 2) @default(24)
  irapRatePct             Decimal          @db.Decimal(5, 2) @default(3.9)
  capitalGainsTaxRatePct  Decimal          @db.Decimal(5, 2) @default(26)
  notes                   String?
  updatedAt               DateTime         @updatedAt

  @@map("fiscal_settings")
}

model RenovationSettings {
  dealId            String   @id
  deal              Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contingencyPct    Decimal  @db.Decimal(5, 2) @default(5)
  // Solo per deal RISTRUTTURAZIONE_CLIENTE: ricarico % applicato di default
  // al costo (taxableAmount) delle voci Materiali/Lavorazioni per calcolare
  // il "prezzo cliente" nel preventivo, quando la voce non ha un prezzo
  // cliente impostato manualmente.
  materialMarkupPct Decimal  @db.Decimal(5, 2) @default(0)
  laborMarkupPct    Decimal  @db.Decimal(5, 2) @default(0)
  // Aliquota IVA applicata una volta sola sul totale del preventivo cliente
  // (non per singola voce): 10% per i privati (ristrutturazione edilizia),
  // 22% per le società, sempre modificabile a mano per deal.
  quoteVatRatePct   Decimal  @db.Decimal(5, 2) @default(10)
  // Nel preventivo cliente: se true, le voci Materiali restano elencate (una
  // riga per voce, con descrizione) ma senza prezzo singolo — solo un totale
  // unico a fine gruppo, cosi' il cliente vede cosa e' incluso senza i prezzi
  // di ogni articolo. Se false, ogni voce materiale mostra il suo prezzo.
  unifyMaterialPricesInQuote Boolean @default(false)
  updatedAt         DateTime @updatedAt

  @@map("renovation_settings")
}

// ---------------------------------------------------------------------------
// Costi (righe unificate per tutti i moduli: Acquisto e Spese, Materiali,
// Lavorazioni *, Enti Esterni — le categorie sono liberamente configurabili
// dall'utente, raggruppate per "group" ai fini di subtotali/sensitivity)
// ---------------------------------------------------------------------------

enum CostCategoryGroup {
  ACQUISIZIONE
  MATERIALI
  LAVORAZIONI
  ENTI_ESTERNI
  ALTRO
}

// tenantId nullable = categoria di sistema (seed globale, visibile a tutti i tenant)
model CostCategory {
  id       String            @id @default(cuid())
  tenantId String?
  tenant   Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    CostCategoryGroup
  name     String
  order    Int               @default(0)

  costLineItems  CostLineItem[]
  priceListItems PriceListItem[]

  @@index([tenantId])
  @@map("cost_categories")
}

enum CostLineItemStatus {
  DA_FARE
  IN_CORSO
  COMPLETATO
}

model CostLineItem {
  id               String             @id @default(cuid())
  dealId           String
  deal             Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  categoryId       String
  category         CostCategory       @relation(fields: [categoryId], references: [id])
  description      String
  quantity         Decimal?           @db.Decimal(10, 3) // mq/pz/ml ecc. — solo per mostrare MQ/Prezzo/Qtà nel preventivo stampato, taxableAmount resta il valore di riferimento
  unit             String?            // "mq", "pz", "ml", ecc.
  taxableAmount    Decimal            @db.Decimal(14, 2) // imponibile — input
  vatRatePct       Decimal            @db.Decimal(5, 2)  @default(22) // input: 22 / 10 / 0 / altro
  nonTaxableAmount Decimal            @db.Decimal(14, 2) @default(0) // porzione fuori campo IVA dello stesso costo (es. pagata in contanti senza fattura)
  clientPrice      Decimal?           @db.Decimal(14, 2) // prezzo (imponibile) fatto pagare al cliente, usato solo nei deal di tipo RISTRUTTURAZIONE_CLIENTE per generare il preventivo
  paidAmount       Decimal            @db.Decimal(14, 2) @default(0)  // input
  status           CostLineItemStatus @default(DA_FARE)
  isMemo           Boolean            @default(false) // true = esclusa dai totali (solo tracciabilità)
  isUnbilled       Boolean            @default(false) // true = contanti/non fatturato: inclusa nei totali ma segnalata
  vendorId         String?
  vendor           Vendor?            @relation(fields: [vendorId], references: [id])
  selectedQuoteId  String?            @unique
  selectedQuote    Quote?             @relation("SelectedQuote", fields: [selectedQuoteId], references: [id])
  priceListItemId  String?
  priceListItem    PriceListItem?     @relation(fields: [priceListItemId], references: [id])
  notes            String?
  order            Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  quotes Quote[] @relation("ItemQuotes")

  @@index([dealId])
  @@index([categoryId])
  @@map("cost_line_items")
}

model Quote {
  id             String   @id @default(cuid())
  costLineItemId String
  costLineItem   CostLineItem @relation("ItemQuotes", fields: [costLineItemId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  amount         Decimal  @db.Decimal(14, 2)
  fileUrl        String?
  notes          String?
  createdAt      DateTime @default(now())

  selectedFor CostLineItem? @relation("SelectedQuote")

  @@index([costLineItemId])
  @@map("quotes")
}

model Vendor {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  email     String?
  specialty String?
  notes     String?
  createdAt DateTime @default(now())

  costLineItems  CostLineItem[]
  quotes         Quote[]
  priceListItems PriceListItem[]
  dealPayments   DealVendorPayment[]

  @@index([tenantId])
  @@map("vendors")
}

// Agenda clienti (RISTRUTTURAZIONE_CLIENTE): memorizzata automaticamente
// ogni volta che si salvano i "Dati cliente" di un deal (vedi deal.ts), cosi
// cresce da sola senza bisogno di inserirla a mano una seconda volta.
model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  taxCode   String?
  vatNumber String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("clients")
}

// Quanto pagato a un fornitore su un deal (RISTRUTTURAZIONE_CLIENTE), inserito
// a mano diviso per rata (fino a 3 acconti, ciascuno con la propria % oltre
// all'importo, + un saldo finale), non la somma dei paidAmount delle singole
// voci di costo: in pratica i pagamenti ai fornitori sono a rate e non
// corrispondono 1:1 alle voci di lavorazione.
model DealVendorPayment {
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  acconto1Pct    Decimal? @db.Decimal(5, 2)
  acconto1Amount Decimal  @db.Decimal(14, 2) @default(0)
  acconto2Pct    Decimal? @db.Decimal(5, 2)
  acconto2Amount Decimal  @db.Decimal(14, 2) @default(0)
  acconto3Pct    Decimal? @db.Decimal(5, 2)
  acconto3Amount Decimal  @db.Decimal(14, 2) @default(0)
  saldoAmount    Decimal  @db.Decimal(14, 2) @default(0)
  updatedAt      DateTime @updatedAt

  @@id([dealId, vendorId])
  @@map("deal_vendor_payments")
}

// Libreria prezzi riutilizzabile — l'asset che cresce di valore nel tempo
model PriceListItem {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId        String
  category          CostCategory @relation(fields: [categoryId], references: [id])
  name              String
  unit              String? // mq, cad, ml, a corpo...
  unitPrice         Decimal      @db.Decimal(14, 2)
  vendorId          String?
  vendor            Vendor?      @relation(fields: [vendorId], references: [id])
  specification     String? // descrizione estesa / capitolato (marca, modello, caratteristiche tecniche)
  referenceQuantity String? // a cosa si applica il prezzo, es. "a corpo per bagno fino a 5mq", "al pezzo"
  notes             String?
  includeInPreventivo   Boolean  @default(true) // richiamabile nel form "Aggiungi voce" del preventivo di un deal
  includeInBusinessPlan Boolean  @default(false) // taggata per l'inclusione nel business plan (Fase 3)
  // Due librerie prezzi separate: una voce creata per i Flip non compare
  // nel menu "Voce" di un deal "Ristrutturazione per un cliente" e viceversa.
  libraryScope      DealOperationType @default(FLIP)
  updatedAt         DateTime     @updatedAt

  costLineItems CostLineItem[]
  templateItems CostTemplateItem[]

  @@index([tenantId])
  @@index([vendorId])
  @@map("price_list_items")
}

// Pacchetto di voci della libreria prezzi riutilizzabile (es. "Bagno
// standard"): invece di spuntare ogni volta le stesse voci nel selettore
// multiplo, si salva la selezione una volta e la si applica in un click ai
// deal successivi dello stesso tipo (libraryScope).
model CostTemplate {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  libraryScope DealOperationType
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  items CostTemplateItem[]

  @@index([tenantId])
  @@map("cost_templates")
}

model CostTemplateItem {
  id              String       @id @default(cuid())
  templateId      String
  template        CostTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  priceListItemId String
  priceListItem   PriceListItem @relation(fields: [priceListItemId], references: [id], onDelete: Cascade)
  quantity        Decimal      @db.Decimal(10, 3) @default(1)
  order           Int          @default(0)

  @@index([templateId])
  @@map("cost_template_items")
}

// ---------------------------------------------------------------------------
// Finanziamento
// ---------------------------------------------------------------------------

enum LoanType {
  MUTUO_PONTE
  PRESTITO_SOCI
  ALTRO
}

enum AmortizationType {
  INTEREST_ONLY
  FRENCH
  MANUAL
}

model Loan {
  id                    String           @id @default(cuid())
  dealId                String
  deal                  Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name                  String
  type                  LoanType         @default(MUTUO_PONTE)
  principalAmount       Decimal          @db.Decimal(14, 2)
  annualInterestRatePct Decimal          @db.Decimal(6, 3)
  durationMonths        Int
  amortizationType      AmortizationType @default(INTEREST_ONLY)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Persistito solo se amortizationType = MANUAL (piano reale fornito dalla banca).
  // Per INTEREST_ONLY / FRENCH il piano è calcolato dal motore di calcolo condiviso.
  manualPayments LoanPayment[]

  @@index([dealId])
  @@map("loans")
}

model LoanPayment {
  id               String  @id @default(cuid())
  loanId           String
  loan             Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  month            Int
  principalPortion Decimal @db.Decimal(14, 2)
  interestPortion  Decimal @db.Decimal(14, 2)

  @@unique([loanId, month])
  @@map("loan_payments")
}

// Finanziamento aziendale "reale" (non legato a un singolo deal): un mutuo o
// prestito con un piano di ammortamento reale fornito dalla banca, importato
// una volta sola con le rate vere (data + quota capitale + quota interessi).
// Usato per calcolare in automatico gli interessi di un flip in base alla
// finestra [AcquisitionDetails.purchaseDate, +durata cantiere]: si sommano
// le quote interessi delle rate di TUTTI i CompanyLoan del tenant che cadono
// in quella finestra, invece di stimare un tasso teorico per ogni deal.
model CompanyLoan {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime             @default(now())
  payments  CompanyLoanPayment[]

  @@index([tenantId])
  @@map("company_loans")
}

model CompanyLoanPayment {
  id               String      @id @default(cuid())
  companyLoanId    String
  companyLoan      CompanyLoan @relation(fields: [companyLoanId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  principalPortion Decimal     @db.Decimal(14, 2)
  interestPortion  Decimal     @db.Decimal(14, 2)

  @@index([companyLoanId, dueDate])
  @@map("company_loan_payments")
}

// Capitale proprio (equity) e soci/co-investitori — non genera interessi,
// partecipa a utili tramite profitSharePct
model Partner {
  id                 String  @id @default(cuid())
  dealId             String
  deal               Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name               String
  contributionAmount Decimal @db.Decimal(14, 2)
  profitSharePct     Decimal @db.Decimal(5, 2)
  linkedUserId       String?
  notes              String?

  @@index([dealId])
  @@map("partners")
}

// Costi di detenzione ricorrenti NON legati a un finanziamento (l'interesse
// sul debito viene dal modulo Loan, per non duplicarlo)
model HoldingCostsConfig {
  dealId              String   @id
  deal                Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  durationMonths      Int      @default(6)
  monthlyInsurance    Decimal  @db.Decimal(14, 2) @default(0)
  monthlyUtilities    Decimal  @db.Decimal(14, 2) @default(0)
  monthlyPropertyTax  Decimal  @db.Decimal(14, 2) @default(0)
  monthlyCondoFees    Decimal  @db.Decimal(14, 2) @default(0)
  otherMonthlyCosts   Decimal  @db.Decimal(14, 2) @default(0)
  updatedAt           DateTime @updatedAt

  @@map("holding_costs_config")
}

// ---------------------------------------------------------------------------
// Vendita
// ---------------------------------------------------------------------------

enum SaleScenarioType {
  PRUDENTE
  REALISTICO
  OTTIMISTICO
}

model SaleScenario {
  id                  String           @id @default(cuid())
  dealId              String
  deal                Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  scenario            SaleScenarioType
  estimatedSalePrice  Decimal          @db.Decimal(14, 2) // imponibile — IVA calcolata a parte se saleSubjectToVat
  vatRatePct          Decimal          @db.Decimal(5, 2)  @default(0)
  agencyFeesSellPct   Decimal          @db.Decimal(5, 2)  @default(3)
  marketingStagingCosts Decimal        @db.Decimal(14, 2) @default(0)
  closingCosts        Decimal          @db.Decimal(14, 2) @default(0)
  updatedAt           DateTime         @updatedAt

  @@unique([dealId, scenario])
  @@map("sale_scenarios")
}

// ---------------------------------------------------------------------------
// Note / avvertenze
// ---------------------------------------------------------------------------

enum NoteSeverity {
  INFO
  AVVISO
  CRITICO
}

model Note {
  id                String       @id @default(cuid())
  dealId            String
  deal              Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  relatedEntityType String?      // es. "CostLineItem", "Loan", "SaleScenario"
  relatedEntityId   String?
  text              String
  severity          NoteSeverity @default(INFO)
  isResolved        Boolean      @default(false)
  createdById       String
  createdBy         User         @relation(fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())
  resolvedAt        DateTime?

  @@index([dealId, isResolved])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Business plan
// ---------------------------------------------------------------------------

model CompanyProfile {
  tenantId      String   @id
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName   String?
  logoUrl       String?
  primaryColor  String?
  secondaryColor String?
  teamBio       String?
  website       String?
  updatedAt     DateTime @updatedAt

  @@map("company_profiles")
}

model BusinessPlanTemplate {
  id           String  @id @default(cuid())
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  layoutConfig Json
  isDefault    Boolean @default(false)

  businessPlans BusinessPlan[]

  @@index([tenantId])
  @@map("business_plan_templates")
}

enum BusinessPlanStatus {
  BOZZA
  FINALE
}

model BusinessPlan {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId          String
  template            BusinessPlanTemplate @relation(fields: [templateId], references: [id])
  title               String
  executiveSummary    String?
  investorProfileText String?
  status              BusinessPlanStatus  @default(BOZZA)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  deals BusinessPlanDeal[]

  @@index([tenantId])
  @@map("business_plans")
}

model BusinessPlanDeal {
  businessPlanId String
  businessPlan   BusinessPlan @relation(fields: [businessPlanId], references: [id], onDelete: Cascade)
  dealId         String
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([businessPlanId, dealId])
  @@map("business_plan_deals")
}

// ---------------------------------------------------------------------------
// Allegati
// ---------------------------------------------------------------------------

enum AttachmentType {
  LOGO
  QUOTE_FILE
  EXPORT_PDF
  EXPORT_DOCX
  OTHER
}

model Attachment {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type           AttachmentType
  fileUrl        String
  fileName       String
  mimeType       String
  uploadedById   String
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime       @default(now())

  @@index([tenantId])
  @@index([dealId])
  @@map("attachments")
}
